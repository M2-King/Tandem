{
  "name": "tandem-desktop",
  "productName": "Tandem",
  "version": "0.3.0",
  "description": "Tandem desktop app: real Python with an AI assistant, in a native window.",
  "author": "Tandem",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --publish never",
    "dist:dir": "electron-builder --dir --publish never"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "app.tandem.desktop",
    "productName": "Tandem",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "build/icon.ico",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../out/tandem-runtime",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon-mac.png",
      "category": "public.app-category.developer-tools",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tandem",
      "artifactName": "Tandem-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Tandem-${version}-portable.exe"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.png",
      "category": "Development"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.10"
  }
}
