# Tandem Cowork. Copy to .env.local (not committed) and fill in.
#
# fixture: the UI preview with sample data (no server).
# live:    a Tandem Supabase staging project (see docs/cowork-backend.md).
VITE_COWORK_MODE=fixture

# Live mode only: the staging project's URL and its publishable key.
# Never put a secret or service-role key here: it would ship in the app.
VITE_TANDEM_SUPABASE_URL=
VITE_TANDEM_SUPABASE_KEY=
